				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/usr/bin/env bash
# Transcribe — Finder Quick Action. Hands the selected audio files to the
# app as ordinary open-file events; the app owns the job (notch HUD, cancel,
# `&lt;file&gt;.md` beside the audio).
set -u

# Automator may pass the files as arguments ($@) or on stdin.
FILES=("$@")
if [ "${#FILES[@]}" -eq 0 ]; then
  while IFS= read -r line; do
    [ -n "$line" ] &amp;&amp; FILES+=("$line")
  done
fi
[ "${#FILES[@]}" -eq 0 ] &amp;&amp; exit 0

APP="/Applications/Transcribe.app"
[ -d "$APP" ] || APP="$HOME/Applications/Transcribe.app"
if [ ! -d "$APP" ]; then
  osascript -e 'display notification "Transcribe.app is not installed in Applications." with title "Transcribe"' 2&gt;/dev/null
  exit 1
fi

for file in "${FILES[@]}"; do
  /usr/bin/open -g -a "$APP" "$file" || exit 1
done</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
				</dict>
