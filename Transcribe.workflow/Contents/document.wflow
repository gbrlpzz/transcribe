				</array>
				<key>Class Name</key>
				<string>RunShellScriptAction</string>
				<key>InputUUID</key>
				<string>01516EF8-9CD9-43FE-ABB8-F763B6433B1E</string>
				<key>Keywords</key>
				<array>
					<string>Shell</string>
					<string>Script</string>
				</array>
				<key>OutputUUID</key>
				<string>AFADFB04-4439-4572-9652-19572E280AF3</string>
				<key>UUID</key>
				<string>EFEBF585-AA3B-4AF2-B78D-E4DB8ACD8AA0</string>
				<key>UnlocalizedApplications</key>
